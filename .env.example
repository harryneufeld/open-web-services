# Copy to .env (git-ignored) and adjust. Compose reads it automatically.

# PostgreSQL password. The default "ows" is only for local development: set your own for any real deployment.
POSTGRES_PASSWORD=ows

# Image the app service runs. Default: the published image on GitHub Container Registry.
# Build from this folder instead with `docker compose up -d --build`.
# OWS_IMAGE=ghcr.io/harryneufeld/open-web-services:latest

# Host port for the web app.
# OWS_PORT=8080

# true: allow the sign-in cookie over plain HTTP (trusted LAN only). false: behind a TLS reverse proxy.
# OWS_INSECURE_COOKIE=true
