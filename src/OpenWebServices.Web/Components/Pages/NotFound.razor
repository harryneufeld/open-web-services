@page "/not-found"
@layout MainLayout
@attribute [AllowAnonymous]

<PageTitle>Not found · ows</PageTitle>

<div class="panel">
    <EmptyState IconName="alert" Title="Page not found">
        <ChildContent>The page you were looking for does not exist or was removed.</ChildContent>
        <Actions><a class="btn" href="/">Back to overview</a></Actions>
    </EmptyState>
</div>
