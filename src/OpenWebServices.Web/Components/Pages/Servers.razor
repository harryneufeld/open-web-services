@page "/"
@rendermode InteractiveServer
@inject UseCaseRunner Runner

<PageTitle>Servers</PageTitle>

<div class="page-head">
    <h1>Servers</h1>
    <a class="btn primary" href="/servers/new">New server</a>
</div>

<LiveUpdates Topics="[ResourceTopics.Servers, ResourceTopics.Groups]" OnChange="LoadAsync" />

@if (_error is not null)
{
    <p class="alert">@_error</p>
}

@if (_servers is null)
{
    <p>Loading…</p>
}
else if (_servers.Count == 0)
{
    <p class="muted">No servers yet. Add a provider group under <a href="/groups">Groups</a> to import existing servers, then create new ones here.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Group</th><th>Location</th><th>Type</th><th>Status</th><th>IPv4</th><th class="num">Net / month</th></tr>
        </thead>
        <tbody>
            @foreach (var view in _servers)
            {
                var s = view.Server;
                <tr>
                    <td>
                        <a href="/servers/@s.Id">@s.Name</a>
                        @if (s.Origin == ServerOrigin.Imported)
                        {
                            <span class="tag" title="Found at the provider; not created here">imported</span>
                        }
                    </td>
                    <td>@view.GroupName <span class="muted">@view.ProviderName</span></td>
                    <td>@s.Location</td>
                    <td>@s.ServerType</td>
                    <td><StatusBadge Text="@s.Status.ToString()" Busy="s.IsTransitioning" /></td>
                    <td>@(s.PublicIpv4 ?? "–")</td>
                    <td class="num">@Formatting.Money(s.MonthlyPriceNet, s.Currency)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ServerView>? _servers;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _servers = await Runner.RunAsync<ServerQueries, IReadOnlyList<ServerView>>(q => q.ListAsync(CancellationToken.None));
            _error = null;
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
    }
}
