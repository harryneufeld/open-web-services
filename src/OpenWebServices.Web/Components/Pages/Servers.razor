@page "/servers"
@rendermode InteractiveServer
@inject UseCaseRunner Runner

<PageTitle>Servers · ows</PageTitle>

<LiveUpdates Topics="[ResourceTopics.Servers, ResourceTopics.Groups]" OnChange="LoadAsync" />

<header class="page-header">
    <div>
        <span class="svc-line"><ServiceBadge Service="OwsService.Servers" /><b>@OwsService.Servers.Name</b><span class="tagline"> · @OwsService.Servers.Tagline</span></span>
        <h1>Servers</h1>
            </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="/servers/new"><Icon Name="plus" />Launch server</a>
    </div>
</header>

@if (_error is not null)
{
    <Notice Kind="error">@_error</Notice>
}

<section class="panel">
    @if (_servers is null)
    {
        <SkeletonRows />
    }
    else if (_servers.Count == 0)
    {
        <EmptyState IconName="server" Title="No servers yet">
            <ChildContent>Add a provider group to import existing servers, or create a new one from the offers of your groups.</ChildContent>
            <Actions>
                <a class="btn" href="/groups">Add provider group</a>
                <a class="btn btn-primary" href="/servers/new"><Icon Name="plus" />New server</a>
            </Actions>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="stack">
                <thead>
                    <tr><th>Name</th><th>Status</th><th>Group</th><th>Location</th><th>Type</th><th>Public IPv4</th><th class="num">Monthly, net</th></tr>
                </thead>
                <tbody>
                    @foreach (var view in Paging.Slice(_servers, _page))
                    {
                        var s = view.Server;
                        <tr>
                            <td>
                                <a class="primary-link" href="/servers/@s.Id">@s.Name</a>
                                @if (s.Origin == ServerOrigin.Imported)
                                {
                                    <span class="tag" title="Found at the provider, not created here">Imported</span>
                                }
                            </td>
                            <td data-label="Status"><StatusBadge Text="@s.Status.ToString()" /></td>
                            <td data-label="Group">@view.GroupName<span class="secondary">@view.ProviderName</span></td>
                            <td data-label="Location">@s.Location</td>
                            <td data-label="Type">@s.ServerType</td>
                            <td data-label="IPv4" class="mono">@(s.PublicIpv4 ?? "–")</td>
                            <td data-label="Monthly" class="num">@Formatting.Money(s.MonthlyPriceNet, s.Currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Total="_servers.Count" @bind-Page="_page" Label="Server pages" />
    }
</section>

@code {
    private IReadOnlyList<ServerView>? _servers;
    private int _page = 1;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _servers = await Runner.RunAsync<ServerQueries, IReadOnlyList<ServerView>>(q => q.ListAsync(CancellationToken.None));
            _error = null;
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
    }
}
