@page "/servers/{Id:guid}"
@rendermode InteractiveServer
@inject UseCaseRunner Runner
@inject IAppTemplateCatalog Templates
@inject NavigationManager Navigation

<PageTitle>@(_view?.Server.Name ?? "Server") · ows</PageTitle>

<LiveUpdates Topics="[ResourceTopics.Servers, ResourceTopics.AppInstalls]" Id="Id" OnChange="LoadAsync" />

<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/servers">Servers</a><Icon Name="chevron-right" /><span>@(_view?.Server.Name ?? "…")</span></nav>

@if (_view is null)
{
    <SkeletonHeader />
    @if (_error is not null)
    {
        <Notice Kind="error">@_error</Notice>
    }
    <section class="panel"><SkeletonRows Count="2" /></section>
}
else
{
    var server = _view.Server;
    <header class="page-header">
        <div>
            <div class="title-row">
                <h1>@server.Name</h1>
                <StatusBadge Text="@server.Status.ToString()" />
                @if (server.Origin == ServerOrigin.Imported)
                {
                    <span class="tag">Imported</span>
                }
            </div>
            <p>@server.ServerType in @server.Location · <a href="/groups/@server.GroupId">@_view.GroupName</a></p>
        </div>
        <div class="page-actions">
            @if (server.Status == ServerStatus.Stopped)
            {
                <button class="btn" disabled="@_busy" @onclick="() => PowerAsync(PowerAction.PowerOn)"><Icon Name="power" />Power on</button>
            }
            else
            {
                <button class="btn" disabled="@(_busy || server.Status != ServerStatus.Running)" @onclick="() => PowerAsync(PowerAction.Reboot)"><Icon Name="rotate" />Reboot</button>
                <button class="btn" disabled="@(_busy || server.Status != ServerStatus.Running)" @onclick="() => PowerAsync(PowerAction.Shutdown)"><Icon Name="stop" />Shut down</button>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <Notice Kind="error">@_error</Notice>
    }
    @if (server.FailureReason is not null)
    {
        <Notice Kind="error">@server.FailureReason</Notice>
    }

    <section class="panel" aria-labelledby="details">
        <div class="panel-header"><h2 id="details">Details</h2></div>
        <div class="panel-body">
            <dl class="facts">
                <div><dt>Public IPv4</dt><dd class="mono with-copy">@(server.PublicIpv4 ?? "–")@if (server.PublicIpv4 is { } ipv4)
                    {
                        <CopyButton Value="@ipv4" Label="IPv4 address" />
                    }</dd></div>
                <div><dt>Provider</dt><dd>@_view.ProviderName</dd></div>
                <div><dt>Group</dt><dd><a href="/groups/@server.GroupId">@_view.GroupName</a></dd></div>
                <div><dt>Location</dt><dd>@server.Location</dd></div>
                <div><dt>Type</dt><dd>@server.ServerType</dd></div>
                <div><dt>Image</dt><dd>@server.Image</dd></div>
                <div><dt>Monthly, net</dt><dd class="num" style="text-align:left">@Formatting.Money(server.MonthlyPriceNet, server.Currency)</dd></div>
                <div><dt>Provider ID</dt><dd class="mono">@(server.ExternalId ?? "–")</dd></div>
                <div><dt>Origin</dt><dd>@(server.Origin == ServerOrigin.Imported ? "Imported from the provider" : "Created in ows")</dd></div>
            </dl>
        </div>
    </section>

    @if (server.ExternalId is not null && server.Status != ServerStatus.Deleting)
    {
        <ServerRescalePanel Server="server" ProviderName="@_view.ProviderName" OnChanged="LoadServerAsync" />
    }

    @if (server.Status != ServerStatus.Deleting)
    {
        <ServerAccessPanel @ref="_access" ServerId="Id" ServerName="@server.Name" OnChanged="LoadServerAsync" />
    }

    @if (server.ExternalId is not null && server.Status != ServerStatus.Deleting)
    {
        <ServerLabelsPanel ServerId="Id" />
        <ServerNetworkingPanel ServerId="Id" />
        <ServerVolumesPanel ServerId="Id" />
        <ServerFirewallPanel ServerId="Id" />
    }

    <section class="panel" aria-labelledby="apps">
        <div class="panel-header">
            <div>
                <h2 id="apps">Apps</h2>
                <p>Docker Compose apps installed over SSH.</p>
            </div>
        </div>
        @if (!server.HasAutomationKey)
        {
            <div class="panel-body">
                <Notice>ows needs access to this server to install apps. An admin can give it access under SSH access.</Notice>
            </div>
        }
        else
        {
            <div class="toolbar">
                <label class="field" style="flex:1; min-width: 240px">
                    <span>App</span>
                    <select @bind="_templateId">
                        @foreach (var t in Templates.All)
                        {
                            <option value="@t.Id">@t.Name – @t.Description</option>
                        }
                    </select>
                </label>
                <button class="btn btn-primary" disabled="@(_busy || !server.CanInstallApps)" @onclick="InstallAsync"><Icon Name="box" />Install</button>
            </div>
            @if (!server.CanInstallApps)
            {
                <div class="panel-body"><p class="hint">Apps can be installed once the server is running.</p></div>
            }
            @if (_installs.Count == 0)
            {
                <div class="panel-body"><p class="hint">No apps installed yet.</p></div>
            }
            @foreach (var install in _installs)
            {
                <details class="log" open="@(install.Status is AppInstallStatus.Installing or AppInstallStatus.Failed)">
                    <summary>
                        <span class="grow">@(Templates.Find(install.TemplateId)?.Name ?? install.TemplateId)</span>
                        <span class="subtle">@Formatting.Ago(install.CreatedAtUtc)</span>
                        <StatusBadge Text="@install.Status.ToString()" />
                    </summary>
                    <pre>@install.Log</pre>
                </details>
            }
        }
    </section>

    <section class="panel danger" aria-labelledby="danger">
        <div class="panel-header">
            <div>
                <h2 id="danger">Delete server</h2>
                <p>Deletes the server at @_view.ProviderName, including its disk. This cannot be undone.</p>
            </div>
            @if (_confirmDelete)
            {
                <div class="page-actions">
                    <button class="btn" @onclick="() => _confirmDelete = false">Cancel</button>
                    <button class="btn btn-danger-solid" disabled="@_busy" @onclick="DeleteAsync"><Icon Name="trash" />Delete @server.Name</button>
                </div>
            }
            else
            {
                <button class="btn btn-danger" disabled="@_busy" @onclick="() => _confirmDelete = true"><Icon Name="trash" />Delete…</button>
            }
        </div>
    </section>
}

@code {
    private ServerView? _view;
    private ServerAccessPanel? _access;
    private IReadOnlyList<AppInstall> _installs = [];
    private string? _error;
    private string _templateId = "";
    private bool _busy;
    private bool _confirmDelete;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
            return; // prerendering only shows the skeleton; data loads once, when the page is interactive
        _templateId = Templates.All[0].Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await LoadServerAsync();
        if (_access is not null)
            await _access.ReloadAsync();
    }

    private async Task LoadServerAsync()
    {
        try
        {
            _view = await Runner.RunAsync<ServerQueries, ServerView>(q => q.GetAsync(Id, CancellationToken.None));
            _installs = await Runner.RunAsync<ServerQueries, IReadOnlyList<AppInstall>>(q => q.ListInstallsAsync(Id, CancellationToken.None));
        }
        catch (NotFoundException)
        {
            Navigation.NavigateTo("/servers");
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
    }

    private Task PowerAsync(PowerAction action) =>
        RunCommandAsync(() => Runner.RunAsync<ControlServerPower>(u => u.ExecuteAsync(Id, action, CancellationToken.None)));

    private Task InstallAsync() =>
        RunCommandAsync(() => Runner.RunAsync<RequestAppInstall, Guid>(u => u.ExecuteAsync(Id, _templateId, CancellationToken.None)));

    private async Task DeleteAsync()
    {
        await RunCommandAsync(() => Runner.RunAsync<DeleteServer>(u => u.ExecuteAsync(Id, CancellationToken.None)));
        if (_error is null)
            Navigation.NavigateTo("/servers");
    }

    private async Task RunCommandAsync(Func<Task> command)
    {
        _busy = true;
        _error = null;
        try
        {
            await command();
            await LoadAsync();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            _confirmDelete = false;
        }
    }
}
