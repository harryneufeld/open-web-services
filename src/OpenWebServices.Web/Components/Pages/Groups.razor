@page "/groups"
@page "/settings"
@rendermode InteractiveServer
@inject UseCaseRunner Runner
@inject IProviderCatalog Catalog

<PageTitle>Groups</PageTitle>

<h1>Provider groups</h1>
<p class="muted">
    A group is one set of credentials at one provider — for Hetzner Cloud that is one project's API token.
    Each group chooses which resources it syncs. Existing resources are imported when a group is added.
</p>

<LiveUpdates Topics="[ResourceTopics.Groups, ResourceTopics.Servers, ResourceTopics.DnsZones]" OnChange="LoadAsync" />

@if (_groups is null)
{
    <p>Loading…</p>
}
else if (_groups.Count == 0)
{
    <p class="muted">No groups yet. Add one below.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Provider</th><th>Syncs</th><th class="num">Servers</th><th class="num">DNS zones</th><th>Last sync</th></tr>
        </thead>
        <tbody>
            @foreach (var view in _groups)
            {
                var g = view.Group;
                <tr>
                    <td><a href="/groups/@g.Id">@g.Name</a></td>
                    <td>@view.ProviderName</td>
                    <td>
                        @foreach (var kind in ResourceKinds.Split(g.EnabledResources))
                        {
                            <span class="tag">@ResourceKinds.Label(kind)</span>
                        }
                    </td>
                    <td class="num">@view.ServerCount</td>
                    <td class="num">@view.ZoneCount</td>
                    <td>
                        @if (g.LastSyncError is not null)
                        {
                            <span class="badge failed" title="@g.LastSyncError">failed</span>
                        }
                        <span class="muted">@Formatting.Ago(g.LastSyncAtUtc)</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Add a group</h2>

@if (Catalog.All.Count == 0)
{
    <p class="muted">No provider types are registered.</p>
}
else
{
    <div class="form stacked narrow">
        <label>Provider
            <select value="@_typeId" @onchange="e => SelectType(e.Value?.ToString())">
                @foreach (var type in Catalog.All)
                {
                    <option value="@type.Id">@type.DisplayName</option>
                }
            </select>
        </label>
        @if (SelectedType is { } selected)
        {
            <p class="muted">@selected.Description</p>
            <label>Name
                <input @bind="_name" placeholder="e.g. Hetzner – production" maxlength="@ProviderGroup.MaxNameLength" />
            </label>
            @foreach (var field in selected.CredentialFields)
            {
                <label>@field.Label
                    <input type="@(field.IsSecret ? "password" : "text")" autocomplete="off"
                           value="@_credentials.GetValueOrDefault(field.Key)"
                           @onchange="e => _credentials[field.Key] = e.Value?.ToString() ?? string.Empty" />
                    @if (field.Help is not null)
                    {
                        <span class="muted">@field.Help</span>
                    }
                </label>
            }
            <fieldset>
                <legend>Sync</legend>
                @foreach (var kind in ResourceKinds.Split(selected.SupportedResources))
                {
                    <label class="inline">
                        <input type="checkbox" checked="@_enabled.HasFlag(kind)" @onchange="e => Toggle(kind, e.Value is true)" />
                        @ResourceKinds.Label(kind)
                    </label>
                }
            </fieldset>
            <div>
                <button class="btn primary" disabled="@(_busy || !CanSubmit)" @onclick="AddAsync">
                    @if (_busy)
                    {
                        <span class="spinner"></span><text>Verifying and importing…</text>
                    }
                    else
                    {
                        <text>Add and import</text>
                    }
                </button>
            </div>
        }
    </div>
}

@if (_message is not null)
{
    <p class="@(_isError ? "alert" : "ok")">@_message</p>
}

@code {
    private IReadOnlyList<GroupView>? _groups;
    private string _typeId = "";
    private string _name = "";
    private Dictionary<string, string> _credentials = [];
    private ResourceKind _enabled;
    private string? _message;
    private bool _isError;
    private bool _busy;

    private ProviderTypeInfo? SelectedType => Catalog.Find(_typeId);

    private bool CanSubmit => SelectedType is { } type
                              && !string.IsNullOrWhiteSpace(_name)
                              && type.CredentialFields.All(f => !string.IsNullOrWhiteSpace(_credentials.GetValueOrDefault(f.Key)));

    protected override async Task OnInitializedAsync()
    {
        if (Catalog.All.Count > 0)
            SelectType(Catalog.All[0].Id);
        await LoadAsync();
    }

    private async Task LoadAsync() =>
        _groups = await Runner.RunAsync<GroupQueries, IReadOnlyList<GroupView>>(q => q.ListAsync(CancellationToken.None));

    private void SelectType(string? typeId)
    {
        _typeId = typeId ?? "";
        _credentials = [];
        var type = SelectedType;
        _enabled = type?.SupportedResources ?? ResourceKind.None;
        _name = type?.DisplayName ?? "";
    }

    private void Toggle(ResourceKind kind, bool on) => _enabled = on ? _enabled | kind : _enabled & ~kind;

    private async Task AddAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var command = new AddProviderGroupCommand(_name, _typeId, _credentials, _enabled);
            var (_, report) = await Runner.RunAsync<AddProviderGroup, (Guid, SyncReport)>(u => u.ExecuteAsync(command, CancellationToken.None));
            (_message, _isError) = ($"Group added. {report}", !report.Succeeded);
            SelectType(_typeId);
            await LoadAsync();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            (_message, _isError) = (ex.Message, true);
        }
        finally
        {
            _busy = false;
        }
    }
}
