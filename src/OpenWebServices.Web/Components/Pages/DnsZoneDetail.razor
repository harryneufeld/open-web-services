@page "/dns/{Id:guid}"
@rendermode InteractiveServer
@inject UseCaseRunner Runner
@inject NavigationManager Navigation

<PageTitle>@(_view?.Zone.Name ?? "DNS zone") · ows</PageTitle>

<LiveUpdates Topics="[ResourceTopics.DnsZones]" Id="Id" OnChange="LoadZoneAsync" />

<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/dns">DNS zones</a><Icon Name="chevron-right" /><span>@(_view?.Zone.Name ?? "…")</span></nav>

@if (_view is null)
{
    <SkeletonHeader />
    <section class="panel"><SkeletonRows Count="2" /></section>
}
else
{
    var zone = _view.Zone;
    <header class="page-header">
        <div>
            <div class="title-row">
                <h1>@zone.Name</h1>
                <StatusBadge Text="@(zone.DelegationStatus ?? zone.Status)" Display="@Overview.DelegationLabel(zone.DelegationStatus)" />
            </div>
            <p>@_view.ProviderName · <a href="/groups/@zone.GroupId">@_view.GroupName</a></p>
        </div>
        <div class="page-actions">
            @if (_editor is null)
            {
                <button class="btn btn-primary" @onclick="NewRecord"><Icon Name="plus" />Add record</button>
            }
        </div>
    </header>

    @if (_error is not null)
    {
        <Notice Kind="error">@_error</Notice>
    }

    <section class="panel" aria-labelledby="zone-details">
        <div class="panel-header"><h2 id="zone-details">Zone</h2></div>
        <div class="panel-body">
            <dl class="facts">
                <div style="grid-column: span 2"><dt>Nameservers</dt><dd class="mono">@foreach (var ns in zone.NameserverList)
                    {
                        <div>@ns.TrimEnd('.')</div>
                    }</dd></div>
                <div><dt>Status at provider</dt><dd><StatusBadge Text="@zone.Status" /></dd></div>
                <div><dt>Default TTL</dt><dd>@(zone.Ttl is { } ttl ? $"{ttl} s" : "–")</dd></div>
            </dl>
        </div>
    </section>

    <section class="panel" aria-labelledby="records">
        <div class="panel-header">
            <h2 id="records">Records</h2>
            <button class="btn btn-ghost btn-sm" disabled="@_loadingRecords" @onclick="LoadRecordsAsync">
                @if (_loadingRecords)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <Icon Name="refresh" />
                }
                Reload
            </button>
        </div>
        @if (_editor is not null && _editing is null)
        {
            <div class="record-form new">@RecordForm(zone.Name)</div>
        }
        @if (_records is null)
        {
            <SkeletonRows Count="5" />
        }
        else if (_records.Count == 0)
        {
            <EmptyState IconName="globe" Title="No records">
                <ChildContent>Add an A record to point the domain at a server.</ChildContent>
            </EmptyState>
        }
        else
        {
            <div class="table-wrap">
                <table class="stack">
                    <thead><tr><th>Name</th><th>Type</th><th class="num">TTL</th><th>Values</th><th><span class="sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var set in Paging.Slice(_records, _page))
                        {
                            @if (_editing == set && _editor is not null)
                            {
                                <tr class="editing"><td colspan="5"><div class="record-form">@RecordForm(zone.Name)</div></td></tr>
                            }
                            else
                            {
                                <tr>
                                    <td class="mono">@set.Name<span class="tag only-sm">@set.Type</span></td>
                                    <td data-label="Type" class="hide-sm"><span class="tag">@set.Type</span></td>
                                    <td data-label="TTL" class="num muted">@(set.Ttl?.ToString() ?? "default")</td>
                                    <td data-label="Values" class="values">@foreach (var value in set.Values)
                                        {
                                            <div>@value</div>
                                        }</td>
                                    <td class="actions">
                                        @if (set.IsManagedByProvider)
                                        {
                                            <span class="subtle">Managed by provider</span>
                                        }
                                        else if (_confirmDelete == set)
                                        {
                                            <button class="btn btn-sm" @onclick="() => _confirmDelete = null">Cancel</button>
                                            <button class="btn btn-sm btn-danger-solid" disabled="@_busy" @onclick="() => DeleteRecordAsync(set)">Delete</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="() => Edit(set)" title="Edit"><Icon Name="edit" /><span class="sr-only">Edit @set.Name @set.Type</span></button>
                                            <button class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="() => _confirmDelete = set" title="Delete"><Icon Name="trash" /><span class="sr-only">Delete @set.Name @set.Type</span></button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="_records.Count" @bind-Page="_page" Label="Record pages" />
        }
    </section>

    <section class="panel danger" aria-labelledby="delete-zone">
        <div class="panel-header">
            <div>
                <h2 id="delete-zone">Delete zone</h2>
                <p>Deletes the zone and all its records at the provider. Websites and mail using it stop resolving.</p>
            </div>
            @if (_confirmDeleteZone)
            {
                <div class="page-actions">
                    <button class="btn" @onclick="() => _confirmDeleteZone = false">Cancel</button>
                    <button class="btn btn-danger-solid" disabled="@_busy" @onclick="DeleteZoneAsync">Delete @zone.Name</button>
                </div>
            }
            else
            {
                <button class="btn btn-danger" @onclick="() => _confirmDeleteZone = true"><Icon Name="trash" />Delete…</button>
            }
        </div>
    </section>
}

@code {
    private ZoneView? _view;
    private IReadOnlyList<DnsRecordSet>? _records;
    private int _page = 1;
    private RecordEditor? _editor;
    private DnsRecordSet? _editing;
    private DnsRecordSet? _confirmDelete;
    private string? _error;
    private bool _busy;
    private bool _loadingRecords;
    private bool _confirmDeleteZone;

    private sealed class RecordEditor
    {
        public string Name { get; set; } = "@";
        public string Type { get; set; } = "A";
        public int? Ttl { get; set; }
        public string Values { get; set; } = "";
    }

    [Parameter] public Guid Id { get; set; }

    /// <summary>The add/edit form, shown in place: above the records when adding, instead of the row when editing.</summary>
    private RenderFragment RecordForm(string zoneName) => __builder =>
    {
        var editor = _editor!;
        <div class="inline-form">
            <label class="field record-name"><span>Name</span>
                <input class="mono" @bind="editor.Name" placeholder="@@" spellcheck="false" disabled="@(_editing is not null)" />
            </label>
            <label class="field record-type"><span>Type</span>
                <select @bind="editor.Type" disabled="@(_editing is not null)">
                    @foreach (var type in DnsRecords.SupportedTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </label>
            <label class="field record-ttl"><span>TTL, seconds</span>
                <input type="number" min="@DnsRecords.MinTtl" @bind="editor.Ttl" placeholder="Zone default" />
            </label>
            <label class="field record-values"><span>Values, one per line</span>
                <textarea class="mono" rows="@ValueRows(editor)" @bind="editor.Values" @bind:event="oninput" spellcheck="false" placeholder="@ValuePlaceholder(editor.Type)"></textarea>
            </label>
        </div>
        <div class="record-form-footer">
            <span class="hint">@@ is @zoneName itself. Zone-file format: MX as “10 mail.example.com.”, absolute names end with a dot. TXT values are quoted automatically.</span>
            <button class="btn" @onclick="CloseEditor">Cancel</button>
            <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(editor.Values))" @onclick="SaveRecordAsync">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                @(_editing is null ? "Add record set" : "Save changes")
            </button>
        </div>
    };

    private static int ValueRows(RecordEditor editor) => Math.Clamp(editor.Values.Count(c => c == '\n') + 1, 1, 8);

    private static string ValuePlaceholder(string type) => type switch
    {
        "A" => "203.0.113.10",
        "AAAA" => "2001:db8::1",
        "CNAME" => "target.example.com.",
        "MX" => "10 mail.example.com.",
        "TXT" => "v=spf1 -all",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive)
            return; // prerendering only shows the skeleton; data loads once, when the page is interactive
        await LoadZoneAsync();
        if (_view is not null)
            await LoadRecordsAsync();
    }

    private async Task LoadZoneAsync()
    {
        try
        {
            _view = await Runner.RunAsync<DnsQueries, ZoneView>(q => q.GetZoneAsync(Id, CancellationToken.None));
        }
        catch (NotFoundException)
        {
            Navigation.NavigateTo("/dns");
        }
    }

    private async Task LoadRecordsAsync()
    {
        _loadingRecords = true;
        try
        {
            _records = await Runner.RunAsync<DnsRecords, IReadOnlyList<DnsRecordSet>>(u => u.ListAsync(Id, CancellationToken.None));
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
            _records ??= [];
        }
        finally
        {
            _loadingRecords = false;
        }
    }

    private void NewRecord()
    {
        _editing = null;
        _editor = new RecordEditor();
    }

    private void Edit(DnsRecordSet set)
    {
        _editing = set;
        _editor = new RecordEditor { Name = set.Name, Type = set.Type, Ttl = set.Ttl, Values = string.Join('\n', set.Values) };
    }

    private void CloseEditor()
    {
        _editing = null;
        _editor = null;
    }

    private Task SaveRecordAsync() => RunAsync(async () =>
    {
        var editor = _editor!;
        var values = editor.Values.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        var set = new DnsRecordSet(editor.Name, editor.Type, editor.Ttl, values);
        if (_editing is null)
            await Runner.RunAsync<DnsRecords>(u => u.CreateAsync(Id, set, CancellationToken.None));
        else
            await Runner.RunAsync<DnsRecords>(u => u.UpdateAsync(Id, set, CancellationToken.None));
        CloseEditor();
    });

    private Task DeleteRecordAsync(DnsRecordSet set) =>
        RunAsync(() => Runner.RunAsync<DnsRecords>(u => u.DeleteAsync(Id, set.Name, set.Type, CancellationToken.None)));

    private Task DeleteZoneAsync() => RunAsync(async () =>
    {
        await Runner.RunAsync<DeleteDnsZone>(u => u.ExecuteAsync(Id, CancellationToken.None));
        Navigation.NavigateTo("/dns");
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadRecordsAsync();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            _confirmDelete = null;
            _confirmDeleteZone = false;
        }
    }
}
