@page "/domains"
@rendermode InteractiveServer
@using System.Globalization
@inject UseCaseRunner Runner

<PageTitle>Domains · ows</PageTitle>

<LiveUpdates Topics="[ResourceTopics.Groups]" OnChange="LoadAsync" />

<header class="page-header">
    <div>
        <span class="svc-line"><ServiceBadge Service="OwsService.Domains" /><b>@OwsService.Domains.Name</b><span class="tagline"> · @OwsService.Domains.Tagline</span></span>
        <h1>Domains</h1>
    </div>
</header>

@if (_error is not null)
{
    <Notice Kind="error">@_error</Notice>
}

@if (_groups is null)
{
    <section class="panel"><SkeletonRows Count="2" /></section>
}
else if (_groups.Count == 0)
{
    <section class="panel">
        <EmptyState IconName="globe" Title="No registrar connected">
            <ChildContent>Turn on domain registrations for a provider group whose provider sells domains, such as OVHcloud.</ChildContent>
            <Actions><a class="btn btn-primary" href="/groups">Open provider groups</a></Actions>
        </EmptyState>
    </section>
}
else
{
    <section class="panel" aria-labelledby="search">
        <div class="panel-header">
            <div>
                <h2 id="search">Find a domain</h2>
                <p>Checks availability and price at every connected registrar. Without an extension, common ones are tried.</p>
            </div>
        </div>
        <form class="toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <label class="field" style="flex:1; min-width:240px"><span>Name</span>
                <input @bind="_query" @bind:event="oninput" placeholder="example or example.com" spellcheck="false" autocomplete="off" />
            </label>
            <button class="btn btn-primary" type="submit" disabled="@(_searching || string.IsNullOrWhiteSpace(_query))">
                @if (_searching)
                {
                    <span class="spinner"></span><text>Searching…</text>
                }
                else
                {
                    <text>Search</text>
                }
            </button>
        </form>
        @foreach (var searchError in _searchErrors)
        {
            <div class="panel-body"><Notice Kind="warn">@searchError</Notice></div>
        }
        @if (_results is { Count: 0 })
        {
            <div class="panel-body"><p class="hint">No registrar returned a result.</p></div>
        }
        else if (_results is not null)
        {
            <div class="table-wrap">
                <table class="stack">
                    <thead><tr><th>Domain</th><th>Group</th><th>Status</th><th class="num">First year, net</th><th class="num">Renewal, net</th><th><span class="sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var r in _results)
                        {
                            <tr class="@(r.Available ? null : "unavailable")">
                                <td class="mono"><strong>@r.Domain</strong>@if (r.IsPremium)
                                    {
                                        <span class="tag billing">Premium</span>
                                    }</td>
                                <td data-label="Group">@r.GroupName</td>
                                <td data-label="Status">
                                    @if (r.Available)
                                    {
                                        <StatusBadge Text="ok" Display="Available" />
                                    }
                                    else
                                    {
                                        <span class="subtle">@(r.Note ?? "Not available")@(r.Transferable ? " Transfer possible." : "")</span>
                                    }
                                </td>
                                <td data-label="First year" class="num">
                                    @if (r.Price is { } p)
                                    {
                                        @Formatting.Money(p, r.Currency)
                                    }
                                    else if (r.TransferPrice is { } tp)
                                    {
                                        @Formatting.Money(tp, r.Currency)<span class="subtle"> transfer</span>
                                    }
                                    else
                                    {
                                        <text>–</text>
                                    }
                                </td>
                                <td data-label="Renewal" class="num muted">@(r.RenewalPrice is { } rp ? Formatting.Money(rp, r.Currency) : "–")</td>
                                <td class="actions">
                                    @if (r.Available && _canOrder)
                                    {
                                        <button class="btn btn-sm" disabled="@_busy" @onclick="() => StartOrder(r, transfer: false)">Order…</button>
                                    }
                                    else if (r.Transferable && _canOrder)
                                    {
                                        <button class="btn btn-sm" disabled="@_busy" @onclick="() => StartOrder(r, transfer: true)">Transfer in…</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!_canOrder && _results.Any(r => r.Available || r.Transferable))
            {
                <div class="panel-body"><p class="hint">Ordering and transferring domains needs the Admin role in this tenant.</p></div>
            }
        }
    </section>

    @if (_ordering is { } candidate)
    {
        <section class="panel" aria-labelledby="order">
            <div class="panel-header">
                <div>
                    @if (_transferring)
                    {
                        <h2 id="order">Transfer @candidate.Domain</h2>
                        <p>Moves the domain to @candidate.GroupName, usually with one year added to its term. The account behind the group becomes holder and contact, and the registrar charges that account.</p>
                    }
                    else
                    {
                        <h2 id="order">Order @candidate.Domain</h2>
                        <p>Registered for one year at @candidate.GroupName, with the account behind the group as holder and contact. The registrar charges that account.</p>
                    }
                </div>
                <button class="btn btn-ghost btn-sm" @onclick="CloseOrder"><Icon Name="x" /><span class="sr-only">Close</span></button>
            </div>
            @if (_placed is { } placed)
            {
                <div class="panel-body stack">
                    <Notice Kind="success">
                        Order @placed.OrderId placed: @Formatting.Money(placed.TotalGross, placed.Currency) including tax.
                        @(placed.PaidAutomatically ? "It was paid with the account's default payment method." : "It is not paid yet.")
                    </Notice>
                    @if (placed.PaymentUrl is { } url)
                    {
                        <p><a class="btn btn-primary" href="@url" target="_blank" rel="noopener noreferrer">Pay the order at the registrar</a></p>
                    }
                    @if (_transferring)
                    {
                        <p class="hint">The transfer starts once the order is paid. The current registrar may e-mail the domain holder to confirm it; most transfers complete within a week. Until then the domain keeps working where it is.</p>
                    }
                    else
                    {
                        <p class="hint">Once the registration is complete, the domain's DNS zone appears under DNS after the next sync.</p>
                    }
                </div>
            }
            else if (_quote is not { } quote)
            {
                <div class="panel-body stack">
                    @if (_transferring)
                    {
                        <label class="field"><span>Auth code</span>
                            <input @bind="_authCodeInput" @bind:event="oninput" spellcheck="false" autocomplete="off" class="mono" />
                        </label>
                        <p class="hint">Also called EPP or transfer code. Ask the current registrar for it and remove the transfer lock there first.</p>
                    }
                    <label class="check"><input type="checkbox" @bind="_legalAge" />The domain holder is of legal age.</label>
                    <p class="hint">The next step prepares the @(_transferring ? "transfer" : "order") at the registrar and shows the exact total and terms. Nothing is ordered yet.</p>
                </div>
                <div class="panel-footer">
                    <button class="btn" @onclick="CloseOrder">Cancel</button>
                    <button class="btn btn-primary" disabled="@(_busy || !_legalAge || (_transferring && string.IsNullOrWhiteSpace(_authCodeInput)))" @onclick="QuoteAsync">
                        @if (_busy)
                        {
                            <span class="spinner"></span>
                        }
                        @(_transferring ? "Review transfer" : "Review order")
                    </button>
                </div>
            }
            else
            {
                <div class="panel-body stack">
                    <div class="table-wrap">
                        <table>
                            <thead><tr><th>Item</th><th class="num">Net</th></tr></thead>
                            <tbody>
                                @foreach (var line in quote.Lines)
                                {
                                    <tr><td>@line.Description</td><td class="num">@Formatting.Money(line.Net, quote.Currency)</td></tr>
                                }
                                <tr><td>Total, net</td><td class="num">@Formatting.Money(quote.TotalNet, quote.Currency)</td></tr>
                                <tr><td><strong>Total, including tax</strong></td><td class="num"><strong>@Formatting.Money(quote.TotalGross, quote.Currency)</strong></td></tr>
                            </tbody>
                        </table>
                    </div>
                    <label class="check"><input type="checkbox" @bind="_payNow" />Pay now with the account's default payment method</label>
                    <label class="check"><input type="checkbox" @bind="_waiveWithdrawal" />Start the registration right away and waive the withdrawal period</label>
                    <p class="hint">Without automatic payment the order waits for payment at the registrar. Without waiving the withdrawal period, the registrar may only start after it ends.</p>
                    @if (quote.Contracts.Count > 0)
                    {
                        <p class="hint">By placing the order you accept the registrar's terms:
                            @for (var i = 0; i < quote.Contracts.Count; i++)
                            {
                                var contract = quote.Contracts[i];
                                <a href="@contract.Url" target="_blank" rel="noopener noreferrer">@contract.Name</a>@(i < quote.Contracts.Count - 1 ? ", " : ".")
                            }
                        </p>
                    }
                </div>
                <div class="panel-footer">
                    <button class="btn" @onclick="CloseOrder">Cancel</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="PlaceAsync">
                        @if (_busy)
                        {
                            <span class="spinner"></span>
                        }
                        @(quote.IsTransfer ? "Place transfer order for" : "Place order for") @Formatting.Money(quote.TotalGross, quote.Currency)
                    </button>
                </div>
            }
        </section>
    }

    <section class="panel" aria-labelledby="registered">
        <div class="panel-header">
            <h2 id="registered">Your domains</h2>
            <button class="btn btn-ghost btn-sm" disabled="@_loadingRegistered" @onclick="LoadRegisteredAsync">
                @if (_loadingRegistered)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <Icon Name="refresh" />
                }
                Reload
            </button>
        </div>
        @if (_registered is null)
        {
            <SkeletonRows Count="3" />
        }
        else
        {
            @foreach (var group in _registered.Where(g => g.Error is not null))
            {
                <div class="panel-body"><Notice Kind="warn">@group.GroupName: @group.Error</Notice></div>
            }
            var all = _registered.SelectMany(g => g.Domains.Select(d => (Group: g, Domain: d))).ToList();
            @if (all.Count == 0)
            {
                <EmptyState IconName="globe" Title="No domains yet">
                    <ChildContent>Domains registered with your registrar groups appear here.</ChildContent>
                </EmptyState>
            }
            else
            {
                <div class="table-wrap">
                    <table class="stack">
                        <thead><tr><th>Domain</th><th>Group</th><th>Registered</th><th>Expires</th><th>Renewal</th><th>Transfer</th><th class="num">Per year, net</th><th><span class="sr-only">Actions</span></th></tr></thead>
                        <tbody>
                            @foreach (var (group, domain) in Paging.Slice(all, _page))
                            {
                                var key = Key(group, domain);
                                var ending = domain.Renewal == DomainRenewal.EndsAtExpiry;
                                <tr>
                                    <td class="mono"><strong>@domain.Name</strong>@if (domain.Note is { } note)
                                        {
                                            <span class="subtle" title="@note"> · details unavailable</span>
                                        }</td>
                                    <td data-label="Group"><a class="subtle" href="/groups/@group.GroupId">@group.GroupName</a></td>
                                    <td data-label="Registered">@Date(domain.RegisteredOn)</td>
                                    <td data-label="Expires">
                                        @Date(domain.ExpiresOn)
                                        @if (DaysLeft(domain) is { } days and <= ExpirySoonDays)
                                        {
                                            <span class="subtle"> · @(days <= 0 ? "today" : days == 1 ? "in 1 day" : $"in {days} days")</span>
                                        }
                                    </td>
                                    <td data-label="Renewal">
                                        @switch (domain.Renewal)
                                        {
                                            case DomainRenewal.Automatic:
                                                <StatusBadge Text="ok" Display="Automatic" />
                                                break;
                                            case DomainRenewal.Manual:
                                                <StatusBadge Text="warn" Display="Manual" />
                                                break;
                                            case DomainRenewal.EndsAtExpiry:
                                                <StatusBadge Text="error" Display="Cancelled" />
                                                break;
                                            default:
                                                <span class="subtle">–</span>
                                                break;
                                        }
                                    </td>
                                    <td data-label="Transfer">
                                        @switch (domain.State, domain.TransferLock)
                                        {
                                            case (DomainState.IncomingTransfer, _):
                                                <StatusBadge Text="pending" Display="Arriving" />
                                                break;
                                            case (DomainState.OutgoingTransfer, _):
                                                <StatusBadge Text="pending" Display="Leaving" />
                                                break;
                                            case (_, DomainTransferLock.Locked):
                                                <StatusBadge Text="ok" Display="Locked" />
                                                break;
                                            case (_, DomainTransferLock.Unlocked):
                                                <StatusBadge Text="warn" Display="Unlocked" />
                                                break;
                                            case (_, DomainTransferLock.Locking or DomainTransferLock.Unlocking):
                                                <StatusBadge Text="pending" Display="@(domain.TransferLock == DomainTransferLock.Locking ? "Locking" : "Unlocking")" />
                                                break;
                                            case (_, DomainTransferLock.NotSupported):
                                                <span class="subtle">No lock</span>
                                                break;
                                            default:
                                                <span class="subtle">–</span>
                                                break;
                                        }
                                    </td>
                                    <td data-label="Per year" class="num">@(domain.YearlyPrice is { } yearly ? Formatting.Money(yearly, domain.Currency) : "–")</td>
                                    <td class="actions">
                                        @if (_canOrder && CanTransferOut(domain) && _confirmCancel != key)
                                        {
                                            <button class="btn btn-sm" disabled="@_busy" aria-expanded="@(_transferOut == key)" @onclick="() => ToggleTransferOut(key)">Transfer out…</button>
                                        }
                                        @if (_canOrder && domain.Renewal != DomainRenewal.Unknown && _confirmCancel == key)
                                        {
                                            <button class="btn btn-sm" disabled="@_busy" @onclick="() => _confirmCancel = null">Keep</button>
                                            <button class="btn btn-sm btn-danger-solid" disabled="@_busy" @onclick="() => SetCancellationAsync(group, domain, true)">
                                                @if (_busy)
                                                {
                                                    <span class="spinner"></span>
                                                }
                                                Cancel at expiry
                                            </button>
                                        }
                                        else if (_canOrder && ending)
                                        {
                                            <button class="btn btn-sm" disabled="@_busy" @onclick="() => SetCancellationAsync(group, domain, false)">Undo cancellation</button>
                                        }
                                        else if (_canOrder && domain.Renewal != DomainRenewal.Unknown && domain.CanEndAtExpiry)
                                        {
                                            <button class="btn btn-sm btn-danger" disabled="@_busy" @onclick="() => _confirmCancel = key">Cancel…</button>
                                        }
                                    </td>
                                </tr>
                                @if (_confirmCancel == key)
                                {
                                    <tr>
                                        <td colspan="8" class="hint">
                                            @domain.Name stays registered and working until @Date(domain.ExpiresOn), then it is released and anyone can register it.
                                            The registrar does not refund the remaining term. You can undo this until it expires.
                                        </td>
                                    </tr>
                                }
                                @if (_transferOut == key)
                                {
                                    <tr>
                                        <td colspan="8">
                                            <div class="stack">
                                                @switch (domain.TransferLock)
                                                {
                                                    case DomainTransferLock.Locked:
                                                        <p class="hint">To move @domain.Name to another registrar, unlock it here, then read its auth code and enter that code when ordering the transfer at the new registrar. While unlocked, anyone with the code can take the domain over.</p>
                                                        <p><button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => SetTransferLockAsync(group, domain, false)">Unlock for transfer</button></p>
                                                        break;
                                                    case DomainTransferLock.Unlocking:
                                                        <p class="hint">The registry is unlocking @domain.Name; this usually takes a few minutes. Reload to check, then read the auth code.</p>
                                                        break;
                                                    case DomainTransferLock.Locking:
                                                        <p class="hint">The registry is locking @domain.Name again. Reload to check.</p>
                                                        break;
                                                    default:
                                                        <p class="hint">Enter this auth code when ordering the transfer at the new registrar. The current term carries over; the new registrar usually adds a year. Lock the domain again if you change your mind.</p>
                                                        @if (_authCodes.TryGetValue(key, out var revealedCode))
                                                        {
                                                            <p><code class="mono" aria-label="Auth code">@revealedCode</code></p>
                                                        }
                                                        <p class="toolbar">
                                                            @if (!_authCodes.ContainsKey(key))
                                                            {
                                                                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => RevealAuthCodeAsync(group, domain)">Show auth code</button>
                                                            }
                                                            @if (domain.TransferLock == DomainTransferLock.Unlocked)
                                                            {
                                                                <button class="btn btn-sm" disabled="@_busy" @onclick="() => SetTransferLockAsync(group, domain, true)">Lock again</button>
                                                            }
                                                        </p>
                                                        break;
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <Pager Total="all.Count" @bind-Page="_page" Label="Domain pages" />
                @if (YearlyTotals(all) is { Count: > 0 } totals)
                {
                    <div class="panel-body">
                        <p class="hint">Renewing domains cost @string.Join(" + ", totals.Select(t => Formatting.Money(t.Amount, t.Currency))) per year, net.
                            @if (!_canOrder)
                            {
                                <text>Cancelling and transferring domains needs the Admin role in this tenant.</text>
                            }
                        </p>
                    </div>
                }
            }
        }
    </section>
}

@code {
    private IReadOnlyList<ProviderGroup>? _groups;
    private IReadOnlyList<GroupDomains>? _registered;
    private IReadOnlyList<DomainAvailability>? _results;
    private IReadOnlyList<string> _searchErrors = [];
    private DomainAvailability? _ordering;
    private DomainQuote? _quote;
    private PlacedDomainOrder? _placed;
    private string? _error;
    private string? _confirmCancel;
    private string? _transferOut;
    private string _authCodeInput = "";
    private bool _transferring;

    /// <summary>Auth codes read in this circuit, by domain key. They are only kept in memory and dropped on reload.</summary>
    private readonly Dictionary<string, string> _authCodes = [];
    private string _query = "";
    private int _page = 1;
    private bool _canOrder;
    private bool _searching;
    private bool _busy;
    private bool _loadingRegistered;
    private bool _legalAge;
    private bool _payNow;
    private bool _waiveWithdrawal;

    // Prerendering only shows the skeleton; data loads once, when the page is interactive.
    protected override Task OnInitializedAsync() => RendererInfo.IsInteractive ? LoadAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        try
        {
            var session = await Runner.RunAsync<SessionQueries, SessionView?>(q => q.GetAsync(CancellationToken.None));
            _canOrder = session?.CurrentTenant?.Role >= TenantRole.Admin;
            _groups = await Runner.RunAsync<DomainQueries, IReadOnlyList<ProviderGroup>>(q => q.ListRegistrarGroupsAsync(CancellationToken.None));
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
            _groups = [];
        }

        if (_groups.Count > 0)
            await LoadRegisteredAsync();
    }

    private async Task LoadRegisteredAsync()
    {
        _loadingRegistered = true;
        try
        {
            _registered = await Runner.RunAsync<DomainQueries, IReadOnlyList<GroupDomains>>(q => q.ListRegisteredAsync(CancellationToken.None));
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
            _registered = [];
        }
        finally
        {
            _loadingRegistered = false;
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) || _searching)
            return;
        _searching = true;
        _error = null;
        try
        {
            var result = await Runner.RunAsync<DomainSearch, DomainSearchResult>(u => u.ExecuteAsync(_query, CancellationToken.None));
            (_results, _searchErrors) = (result.Results, result.Errors);
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _searching = false;
        }
    }

    private const int ExpirySoonDays = 60;

    private static string Key(GroupDomains group, RegisteredDomain domain) => $"{group.GroupId}/{domain.Name}";

    private static string Date(DateOnly? date) => date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "–";

    private static int? DaysLeft(RegisteredDomain domain) =>
        domain.ExpiresOn is { } expires ? expires.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber : null;

    /// <summary>Yearly renewal cost of the domains that are not cancelled, per currency.</summary>
    private static IReadOnlyList<(decimal Amount, string Currency)> YearlyTotals(IEnumerable<(GroupDomains Group, RegisteredDomain Domain)> all) =>
        [.. all.Select(x => x.Domain)
            .Where(d => d.Renewal != DomainRenewal.EndsAtExpiry && d.YearlyPrice is not null)
            .GroupBy(d => d.Currency)
            .Select(g => (g.Sum(d => d.YearlyPrice!.Value), g.Key))];

    private Task SetCancellationAsync(GroupDomains group, RegisteredDomain domain, bool endAtExpiry) => RunAsync(async () =>
    {
        await Runner.RunAsync<ChangeDomainCancellation>(u => u.ExecuteAsync(group.GroupId, domain.Name, endAtExpiry, CancellationToken.None));
        _confirmCancel = null;
        await LoadRegisteredAsync();
    });

    /// <summary>Transfers need an active domain whose lock state the registrar reported.</summary>
    private static bool CanTransferOut(RegisteredDomain domain) =>
        domain.State == DomainState.Active && domain.TransferLock != DomainTransferLock.Unknown;

    private void ToggleTransferOut(string key)
    {
        _transferOut = _transferOut == key ? null : key;
        _authCodes.Remove(key);
    }

    private Task SetTransferLockAsync(GroupDomains group, RegisteredDomain domain, bool locked) => RunAsync(async () =>
    {
        await Runner.RunAsync<ChangeDomainTransferLock>(u => u.ExecuteAsync(group.GroupId, domain.Name, locked, CancellationToken.None));
        _authCodes.Remove(Key(group, domain));
        await LoadRegisteredAsync();
    });

    private Task RevealAuthCodeAsync(GroupDomains group, RegisteredDomain domain) => RunAsync(async () =>
    {
        var code = await Runner.RunAsync<RevealDomainAuthCode, string>(u => u.ExecuteAsync(group.GroupId, domain.Name, CancellationToken.None));
        _authCodes[Key(group, domain)] = code;
    });

    private void StartOrder(DomainAvailability candidate, bool transfer)
    {
        _ordering = candidate;
        _transferring = transfer;
        (_quote, _placed) = (null, null);
        (_legalAge, _payNow, _waiveWithdrawal) = (false, false, false);
        _authCodeInput = "";
        _error = null;
    }

    private void CloseOrder()
    {
        (_ordering, _quote, _placed) = (null, null, null);
        _authCodeInput = "";
    }

    private Task QuoteAsync() => RunAsync(async () =>
    {
        var candidate = _ordering!;
        if (_transferring)
        {
            var authCode = _authCodeInput;
            _quote = await Runner.RunAsync<QuoteDomainTransfer, DomainQuote>(u =>
                u.ExecuteAsync(candidate.GroupId, candidate.Domain, authCode, _legalAge, CancellationToken.None));
            _authCodeInput = "";
        }
        else
        {
            _quote = await Runner.RunAsync<QuoteDomainOrder, DomainQuote>(u =>
                u.ExecuteAsync(candidate.GroupId, candidate.Domain, _legalAge, CancellationToken.None));
        }
    });

    private Task PlaceAsync() => RunAsync(async () =>
    {
        var (candidate, quote) = (_ordering!, _quote!);
        var options = new DomainOrderOptions(_payNow, _waiveWithdrawal);
        _placed = await Runner.RunAsync<PlaceDomainOrder, PlacedDomainOrder>(u =>
            u.ExecuteAsync(candidate.GroupId, quote, options, CancellationToken.None));
        await LoadRegisteredAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex) || ex is ForbiddenException)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
