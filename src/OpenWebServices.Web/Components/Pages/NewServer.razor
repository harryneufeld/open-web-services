@page "/servers/new"
@rendermode InteractiveServer
@inject UseCaseRunner Runner
@inject NavigationManager Navigation

<PageTitle>New server · ows</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/servers">Servers</a><Icon Name="chevron-right" /><span>New server</span></nav>

<header class="page-header">
    <div>
        <h1>New server</h1>
        <p>Pick a size from any of your provider groups. Offers are sorted by monthly net price.</p>
    </div>
</header>

@if (_error is not null)
{
    <Notice Kind="error">@_error</Notice>
}
@foreach (var groupError in _groupErrors)
{
    <Notice Kind="warn">@groupError</Notice>
}

@if (_offers is null)
{
    <section class="panel"><SkeletonRows Count="5" /></section>
}
else if (_offers.Count == 0)
{
    <section class="panel">
        <EmptyState IconName="server" Title="No offers available">
            <ChildContent>Add a provider group with servers enabled to see what you can order.</ChildContent>
            <Actions><a class="btn btn-primary" href="/groups">Add provider group</a></Actions>
        </EmptyState>
    </section>
}
else
{
    var visible = FilteredOffers.ToList();
    var pageRows = Paging.Slice(visible, _page).ToList();
    var footnotes = Footnotes(pageRows);
    <section class="panel" aria-labelledby="offers">
        <div class="panel-header">
            <h2 id="offers">1. Choose an offer</h2>
            <span class="subtle">@visible.Count of @_offers.Count offers</span>
        </div>
        <div class="toolbar">
            @if (Groups.Count > 1)
            {
                <label class="field"><span>Group</span>
                    <select @bind="_groupFilter" @bind:after="FirstPage">
                        <option value="">All groups</option>
                        @foreach (var g in Groups)
                        {
                            <option value="@g">@g</option>
                        }
                    </select>
                </label>
            }
            <label class="field"><span>Country</span>
                <select value="@_countryFilter" @onchange="e => SetCountry(e.Value?.ToString() ?? string.Empty)">
                    <option value="">All countries</option>
                    @foreach (var country in Countries)
                    {
                        <option value="@country">@Formatting.Country(country)</option>
                    }
                </select>
            </label>
            <label class="field"><span>City</span>
                <select @bind="_cityFilter" @bind:after="FirstPage">
                    <option value="">All cities</option>
                    @foreach (var city in Cities)
                    {
                        <option value="@city">@city</option>
                    }
                </select>
            </label>
            @if (Architectures.Count > 1)
            {
                <label class="field"><span>Architecture</span>
                    <select @bind="_architectureFilter" @bind:after="FirstPage">
                        <option value="">All</option>
                        @foreach (var architecture in Architectures)
                        {
                            <option value="@architecture">@architecture</option>
                        }
                    </select>
                </label>
            }
            <label class="field"><span>Min. vCPUs</span>
                <select @bind="_minCpus" @bind:after="FirstPage"><option value="1">1</option><option value="2">2</option><option value="4">4</option><option value="8">8</option><option value="16">16</option></select>
            </label>
            <label class="field"><span>Min. memory</span>
                <select @bind="_minMemory" @bind:after="FirstPage"><option value="1">1 GB</option><option value="2">2 GB</option><option value="4">4 GB</option><option value="8">8 GB</option><option value="16">16 GB</option><option value="32">32 GB</option></select>
            </label>
            <label class="check"><input type="checkbox" @bind="_onlyAvailable" @bind:after="FirstPage" />Only available now</label>
        </div>
        <div class="table-wrap" style="max-height: 460px">
            <table class="stack offers">
                <thead>
                    <tr><th>Type</th><th>Location</th><th>Group</th><th class="num">vCPU</th><th class="num">Memory</th><th class="num">Disk</th><th class="num">Monthly, net</th><th class="num">Gross</th></tr>
                </thead>
                <tbody>
                    @foreach (var o in pageRows)
                    {
                        <tr class="@(o.Available ? "selectable" : "unavailable") @(o.Key == _selectedKey ? "selected" : null)" @onclick="() => Select(o)">
                            <td><label class="offer-pick"><input type="radio" name="offer" checked="@(o.Key == _selectedKey)" disabled="@(!o.Available)" aria-label="@($"{o.TypeName} in {o.Location}")" /><span><span class="offer-name"><strong>@o.TypeName</strong>@if (o.Billing is { } billing)
                                {
                                    <BillingTag Billing="billing" Number="@(NoteNumber(footnotes, billing))" />
                                }</span><span class="secondary">@o.CpuKind · @o.Architecture</span></span></label></td>
                            <td data-label="Location">@o.LocationCity<span class="secondary">@o.Location · @o.Country</span></td>
                            <td data-label="Group">@o.GroupName</td>
                            <td data-label="vCPU" class="num">@o.VCpus</td>
                            <td data-label="Memory" class="num">@o.MemoryGb GB</td>
                            <td data-label="Disk" class="num">@o.DiskGb GB</td>
                            <td data-label="Monthly" class="num"><strong>@Formatting.Money(o.MonthlyNet, o.Currency)</strong></td>
                            <td data-label="Gross" class="num muted hide-sm">@Formatting.Money(o.MonthlyGross, o.Currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <Pager Total="visible.Count" @bind-Page="_page" Label="Offer pages" />
        @if (footnotes.Count > 0)
        {
            <div class="offer-notes" role="note" aria-label="Billing notes">
                @for (var i = 0; i < footnotes.Count; i++)
                {
                    var number = i + 1;
                    <p><BillingTag Billing="footnotes[i]" Number="number" /><span>@footnotes[i].Note</span></p>
                }
            </div>
        }
    </section>

    <section class="panel" aria-labelledby="configure">
        <div class="panel-header">
            <h2 id="configure">2. Configure</h2>
            @if (Selected is { } chosen)
            {
                <span class="tag accent">@chosen.TypeName · @chosen.LocationCity · @Formatting.Money(chosen.MonthlyNet, chosen.Currency)/mo@(chosen.Billing is { } b ? $" · {b.Label}" : "")</span>
            }
        </div>
        <div class="panel-body">
            <div class="form-grid">
                <label class="field"><span>Name</span>
                    <input @bind="_name" @bind:event="oninput" placeholder="web-1" maxlength="63" />
                    <span class="hint">Lowercase letters, digits and hyphens.</span>
                </label>
                <label class="field"><span>Image</span>
                    <select @bind="_image">
                        @foreach (var image in Images)
                        {
                            <option value="@image">@image</option>
                        }
                    </select>
                </label>
            </div>
        </div>
        <div class="panel-footer">
            @if (Selected is null)
            {
                <span class="subtle" style="margin-right:auto; align-self:center">Select an offer above.</span>
            }
            <button class="btn btn-primary" disabled="@(_busy || Selected is null || string.IsNullOrWhiteSpace(_name))" @onclick="CreateAsync">
                @if (_busy)
                {
                    <span class="spinner"></span><text>Creating…</text>
                }
                else
                {
                    <Icon Name="plus" /><text>Create server</text>
                }
            </button>
        </div>
    </section>
}

@code {
    private static readonly string[] Images = ["ubuntu-24.04", "ubuntu-22.04", "debian-12"];

    private IReadOnlyList<ServerOffer>? _offers;
    private IReadOnlyList<string> _groupErrors = [];
    private string? _error;
    private string? _selectedKey;
    private string _groupFilter = "";
    private int _page = 1;
    private string _countryFilter = "";
    private string _cityFilter = "";
    private string _architectureFilter = "";
    private string _name = "";
    private string _image = Images[0];
    private int _minCpus = 1;
    private int _minMemory = 1;
    private bool _onlyAvailable = true;
    private bool _busy;

    private ServerOffer? Selected => _offers?.FirstOrDefault(o => o.Key == _selectedKey);

    private IReadOnlyList<string> Groups => _offers?.Select(o => o.GroupName).Distinct().Order().ToList() ?? [];

    private IReadOnlyList<string> Countries => _offers?.Select(o => o.Country).Distinct()
        .OrderBy(Formatting.Country, StringComparer.CurrentCulture).ToList() ?? [];

    // Cities follow the chosen country so the list stays short.
    private IReadOnlyList<string> Cities => _offers?.Where(o => Matches(_countryFilter, o.Country))
        .Select(o => o.LocationCity).Distinct().Order(StringComparer.CurrentCulture).ToList() ?? [];

    private IReadOnlyList<string> Architectures => _offers?.Select(o => o.Architecture).Distinct().Order().ToList() ?? [];

    private IEnumerable<ServerOffer> FilteredOffers => _offers!
        .Where(o => o.VCpus >= _minCpus && o.MemoryGb >= _minMemory && (o.Available || !_onlyAvailable)
                    && Matches(_groupFilter, o.GroupName)
                    && Matches(_countryFilter, o.Country)
                    && Matches(_cityFilter, o.LocationCity)
                    && Matches(_architectureFilter, o.Architecture));

    private void FirstPage() => _page = 1;

    private static bool Matches(string filter, string value) => filter.Length == 0 || value == filter;

    // Provider-specific billing remarks, listed once below the table and referenced by number from each offer.
    // Billing remarks of the offers on this page, explained once below the table; each tag repeats its note's number.
    private static List<OfferBilling> Footnotes(IEnumerable<ServerOffer> offers) => offers
        .Select(o => o.Billing).OfType<OfferBilling>().DistinctBy(b => b.Note).ToList();

    private static int NoteNumber(List<OfferBilling> notes, OfferBilling billing) =>
        notes.FindIndex(n => n.Note == billing.Note) + 1;

    private void SetCountry(string country)
    {
        _countryFilter = country;
        _page = 1;
        if (!Cities.Contains(_cityFilter))
            _cityFilter = "";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Runner.RunAsync<GetServerOffers, OffersResult>(q => q.ExecuteAsync(CancellationToken.None));
            (_offers, _groupErrors) = (result.Offers, result.Errors);
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
            _offers = [];
        }
    }

    private void Select(ServerOffer offer)
    {
        if (offer.Available)
            _selectedKey = offer.Key;
    }

    private async Task CreateAsync()
    {
        if (Selected is not { } offer)
            return;

        _busy = true;
        _error = null;
        try
        {
            var command = new ProvisionServerCommand(offer.GroupId, _name.Trim(), offer.Location, offer.TypeName, _image, offer.Billing?.Id);
            var id = await Runner.RunAsync<ProvisionServer, Guid>(u => u.ExecuteAsync(command, CancellationToken.None));
            Navigation.NavigateTo($"/servers/{id}");
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
