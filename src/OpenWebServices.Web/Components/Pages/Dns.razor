@page "/dns"
@rendermode InteractiveServer
@inject UseCaseRunner Runner
@inject NavigationManager Navigation

<PageTitle>DNS · ows</PageTitle>

<LiveUpdates Topics="[ResourceTopics.DnsZones, ResourceTopics.Groups]" OnChange="LoadAsync" />

<header class="page-header">
    <div>
        <span class="svc-line"><ServiceBadge Service="OwsService.Dns" /><b>@OwsService.Dns.Name</b><span class="tagline"> · @OwsService.Dns.Tagline</span></span>
        <h1>DNS zones</h1>
            </div>
    <div class="page-actions">
        @if (!_showForm && _groups is { Count: > 0 })
        {
            <button class="btn btn-primary" @onclick="() => _showForm = true"><Icon Name="plus" />Create zone</button>
        }
    </div>
</header>

@if (_error is not null)
{
    <Notice Kind="error">@_error</Notice>
}

@if (_showForm && _groups is { Count: > 0 })
{
    <section class="panel" aria-labelledby="create">
        <div class="panel-header">
            <div>
                <h2 id="create">Create a zone</h2>
                <p>Afterwards, point the domain's nameservers at your registrar to the ones ows shows for the zone.</p>
            </div>
            <button class="btn btn-ghost btn-sm" @onclick="() => _showForm = false"><Icon Name="x" /><span class="sr-only">Close</span></button>
        </div>
        <div class="panel-body">
            <div class="form-grid">
                <label class="field"><span>Domain</span>
                    <input @bind="_domain" @bind:event="oninput" placeholder="example.com" spellcheck="false" />
                </label>
                <label class="field"><span>Group</span>
                    <select @bind="_groupId">
                        @foreach (var g in _groups)
                        {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                </label>
            </div>
        </div>
        <div class="panel-footer">
            <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_domain))" @onclick="CreateAsync">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                Create zone
            </button>
        </div>
    </section>
}

<section class="panel">
    @if (_zones is null)
    {
        <SkeletonRows />
    }
    else if (_zones.Count == 0)
    {
        <EmptyState IconName="globe" Title="No DNS zones yet">
            <ChildContent>
                @if (_groups is { Count: 0 })
                {
                    <text>No provider group has DNS enabled. Turn it on for a group to import its zones.</text>
                }
                else
                {
                    <text>Zones of your groups appear here automatically, or create a new one.</text>
                }
            </ChildContent>
            <Actions>
                @if (_groups is { Count: 0 })
                {
                    <a class="btn" href="/groups">Manage provider groups</a>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="() => _showForm = true"><Icon Name="plus" />Create zone</button>
                }
            </Actions>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="stack">
                <thead>
                    <tr><th>Domain</th><th>Delegation</th><th>Group</th><th class="num">Records</th><th>Nameservers</th></tr>
                </thead>
                <tbody>
                    @foreach (var view in _zones)
                    {
                        var z = view.Zone;
                        <tr>
                            <td><a class="primary-link" href="/dns/@z.Id">@z.Name</a></td>
                            <td data-label="Delegation"><StatusBadge Text="@(z.DelegationStatus ?? z.Status)" Display="@Overview.DelegationLabel(z.DelegationStatus)" /></td>
                            <td data-label="Group">@view.GroupName<span class="secondary">@view.ProviderName</span></td>
                            <td data-label="Records" class="num">@(z.RecordCount?.ToString() ?? "–")</td>
                            <td data-label="Nameservers" class="mono muted hide-sm">@string.Join(", ", z.NameserverList.Select(n => n.TrimEnd('.')))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<ZoneView>? _zones;
    private IReadOnlyList<ProviderGroup>? _groups;
    private Guid _groupId;
    private string _domain = "";
    private string? _error;
    private bool _busy;
    private bool _showForm;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _zones = await Runner.RunAsync<DnsQueries, IReadOnlyList<ZoneView>>(q => q.ListZonesAsync(CancellationToken.None));
        _groups = await Runner.RunAsync<DnsQueries, IReadOnlyList<ProviderGroup>>(q => q.ListDnsGroupsAsync(CancellationToken.None));
        if (_groups.Count > 0 && _groups.All(g => g.Id != _groupId))
            _groupId = _groups[0].Id;
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var id = await Runner.RunAsync<CreateDnsZone, Guid>(u => u.ExecuteAsync(_groupId, _domain, CancellationToken.None));
            Navigation.NavigateTo($"/dns/{id}");
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
