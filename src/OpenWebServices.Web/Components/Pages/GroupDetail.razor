@page "/groups/{Id:guid}"
@rendermode InteractiveServer
@inject UseCaseRunner Runner
@inject NavigationManager Navigation

<PageTitle>@(_view?.Group.Name ?? "Group") · ows</PageTitle>

<LiveUpdates Topics="[ResourceTopics.Groups]" Id="Id" OnChange="LoadAsync" />

<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/groups">Provider groups</a><Icon Name="chevron-right" /><span>@(_view?.Group.Name ?? "…")</span></nav>

@if (_view is null)
{
    <section class="panel"><SkeletonRows Count="2" /></section>
}
else
{
    var group = _view.Group;
    <header class="page-header">
        <div>
            <div class="title-row">
                <h1>@group.Name</h1>
                @if (group.LastSyncError is not null)
                {
                    <StatusBadge Text="failed" Display="Sync failed" />
                }
                else
                {
                    <StatusBadge Text="ok" Display="In sync" />
                }
            </div>
            <p>@_view.ProviderName · last sync @Formatting.Ago(group.LastSyncAtUtc)</p>
        </div>
        <div class="page-actions">
            <button class="btn" disabled="@_busy" @onclick="SyncNowAsync">
                @if (_busy)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <Icon Name="refresh" />
                }
                Sync now
            </button>
        </div>
    </header>

    @if (group.LastSyncError is not null)
    {
        <Notice Kind="error">@group.LastSyncError</Notice>
    }
    @if (_message is not null)
    {
        <Notice Kind="@(_isError ? "error" : "success")">@_message</Notice>
    }

    <section class="panel" aria-labelledby="resources">
        <div class="panel-header"><h2 id="resources">Resources</h2></div>
        <div class="panel-body">
            <dl class="facts">
                <div><dt>Servers</dt><dd><a href="/servers">@_view.ServerCount</a></dd></div>
                <div><dt>DNS zones</dt><dd><a href="/dns">@_view.ZoneCount</a></dd></div>
                <div><dt>Syncs</dt><dd>@string.Join(", ", ResourceKinds.Split(group.EnabledResources).Select(ResourceKinds.Label))</dd></div>
                <div><dt>Added</dt><dd>@group.CreatedAtUtc.ToString("yyyy-MM-dd")</dd></div>
            </dl>
        </div>
    </section>

    <section class="panel" aria-labelledby="settings">
        <div class="panel-header"><h2 id="settings">Settings</h2></div>
        <div class="panel-body">
            <div class="form-stack">
                <label class="field"><span>Name</span>
                    <input @bind="_name" @bind:event="oninput" maxlength="@ProviderGroup.MaxNameLength" />
                </label>
                @if (_view.Type is { } type)
                {
                    <div class="field">
                        <span class="field-label">Sync</span>
                        <div class="choice-group">
                            @foreach (var kind in ResourceKinds.Split(type.SupportedResources))
                            {
                                <label class="check">
                                    <input type="checkbox" checked="@_enabled.HasFlag(kind)" @onchange="e => Toggle(kind, e.Value is true)" />
                                    @ResourceKinds.Label(kind)
                                </label>
                            }
                        </div>
                        <span class="hint">Turning a kind off keeps its records in ows but stops refreshing them.</span>
                    </div>
                    @if (type.HasCommitmentOffers)
                    {
                        <div class="field">
                            <span class="field-label">Offers</span>
                            <label class="check">
                                <input type="checkbox" @bind="_showCommitmentOffers" />
                                Show offers with a billing commitment
                            </label>
                            <span class="hint">For example monthly billing: cheaper than hourly, but billed for the whole period.</span>
                        </div>
                    }
                    @foreach (var field in type.CredentialFields)
                    {
                        var current = _view.Credentials?.FirstOrDefault(c => c.Key == field.Key)?.Display;
                        <label class="field"><span>@field.Label</span>
                            <input type="@(field.IsSecret ? "password" : "text")" autocomplete="off" spellcheck="false"
                                   placeholder="@(current is null ? "Not set" : "Leave empty to keep the current value")"
                                   value="@_credentials.GetValueOrDefault(field.Key)"
                                   @oninput="e => _credentials[field.Key] = e.Value?.ToString() ?? string.Empty" />
                            @if (current is not null)
                            {
                                <span class="hint">Current: <code>@current</code></span>
                            }
                        </label>
                    }
                }
                else
                {
                    <Notice Kind="warn">Provider type “@group.ProviderType” is not available in this version of ows.</Notice>
                }
            </div>
        </div>
        <div class="panel-footer">
            <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))" @onclick="SaveAsync">Save changes</button>
        </div>
    </section>

    <section class="panel danger" aria-labelledby="remove">
        <div class="panel-header">
            <div>
                <h2 id="remove">Remove group</h2>
                <p>Stops managing this group. Its servers and zones keep running at the provider, but SSH keys of servers created in ows are deleted.</p>
            </div>
            @if (_confirmRemove)
            {
                <div class="page-actions">
                    <button class="btn" @onclick="() => _confirmRemove = false">Cancel</button>
                    <button class="btn btn-danger-solid" disabled="@_busy" @onclick="RemoveAsync">Remove @group.Name</button>
                </div>
            }
            else
            {
                <button class="btn btn-danger" @onclick="() => _confirmRemove = true">Remove…</button>
            }
        </div>
    </section>
}

@code {
    private GroupView? _view;
    private string _name = "";
    private ResourceKind _enabled;
    private bool _showCommitmentOffers = true;
    private Dictionary<string, string> _credentials = [];
    private string? _message;
    private bool _isError;
    private bool _busy;
    private bool _confirmRemove;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (_view is not null)
            (_name, _enabled, _showCommitmentOffers) = (_view.Group.Name, _view.Group.EnabledResources, _view.Group.ShowCommitmentOffers);
    }

    private async Task LoadAsync()
    {
        try
        {
            _view = await Runner.RunAsync<GroupQueries, GroupView>(q => q.GetAsync(Id, CancellationToken.None));
        }
        catch (NotFoundException)
        {
            Navigation.NavigateTo("/groups");
        }
    }

    private void Toggle(ResourceKind kind, bool on) => _enabled = on ? _enabled | kind : _enabled & ~kind;

    private Task SyncNowAsync() => RunAsync(async () =>
    {
        var report = await Runner.RunAsync<SyncGroup, SyncReport>(u => u.ExecuteAsync(Id, CancellationToken.None));
        (_message, _isError) = ($"Synced. {report}", !report.Succeeded);
    });

    private Task SaveAsync() => RunAsync(async () =>
    {
        var command = new UpdateProviderGroupCommand(Id, _name, _enabled, _credentials, _showCommitmentOffers);
        var report = await Runner.RunAsync<UpdateProviderGroup, SyncReport>(u => u.ExecuteAsync(command, CancellationToken.None));
        _credentials = [];
        (_message, _isError) = ($"Saved. {report}", !report.Succeeded);
    });

    private Task RemoveAsync() => RunAsync(async () =>
    {
        await Runner.RunAsync<RemoveProviderGroup>(u => u.ExecuteAsync(Id, CancellationToken.None));
        Navigation.NavigateTo("/groups");
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            (_message, _isError) = (ex.Message, true);
        }
        finally
        {
            _busy = false;
            _confirmRemove = false;
        }
    }
}
