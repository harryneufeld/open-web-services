@* Status with a coloured dot; transitional states show a spinner so pending work is visible. *@
<span class="status @Tone">@if (Tone == "busy")
    {
        <span class="spinner" aria-hidden="true"></span>
    }@Label</span>

@code {
    private static readonly HashSet<string> Ok = ["running", "ok", "installed", "valid", "on", "active"];
    private static readonly HashSet<string> Danger = ["failed", "error", "invalid", "locked"];
    private static readonly HashSet<string> Busy = ["provisioning", "starting", "stopping", "rescaling", "deleting", "pending", "installing", "updating"];

    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>Overrides the label shown; the tone still comes from <see cref="Text"/>.</summary>
    [Parameter] public string? Display { get; set; }

    private string Key => Text.ToLowerInvariant();
    private string Label => Display ?? (Text.Length == 0 ? "Unknown" : char.ToUpperInvariant(Text[0]) + Text[1..]);

    private string Tone =>
        Ok.Contains(Key) ? "ok"
        : Danger.Contains(Key) ? "danger"
        : Busy.Contains(Key) ? "busy"
        : "neutral";
}
