@* Addresses, reverse DNS and private networks of one server, read live from the provider. *@
@inject UseCaseRunner Runner

<section class="panel" aria-labelledby="networking">
    <div class="panel-header">
        <div>
            <h2 id="networking">Networking</h2>
            <p>Public addresses, reverse DNS and private networks, live from the provider.</p>
        </div>
        <button class="btn btn-ghost btn-sm" disabled="@_loading" @onclick="LoadAsync">
            @if (_loading)
            {
                <span class="spinner"></span>
            }
            else
            {
                <Icon Name="refresh" />
            }
            Reload
        </button>
    </div>
    @if (_error is not null)
    {
        <div class="panel-body"><Notice Kind="error">@_error</Notice></div>
    }
    @if (_view is null)
    {
        <SkeletonRows Count="2" />
    }
    else if (_view.Networking is not { } net)
    {
        <div class="panel-body"><Notice>@_view.Unavailable</Notice></div>
    }
    else
    {
        <div class="panel-body stack">
            <dl class="facts">
                <div><dt>Public IPv4</dt><dd class="mono">@(net.PublicIpv4 ?? "–")</dd></div>
                <div><dt>Public IPv6</dt><dd class="mono">@(net.PublicIpv6 ?? "–")</dd></div>
            </dl>

            <section class="panel-section" aria-labelledby="rdns">
                <h3 id="rdns">Reverse DNS</h3>
                @if (!net.CanEditReverseDns && net.ReverseDns.Count == 0)
                {
                    <p class="hint">This provider's reverse DNS is not managed in ows. Change it in the provider's console.</p>
                }
                else
                {
                    <div class="edit-grid two">
                        <div class="row head"><span>Address</span><span>Host name</span><span></span></div>
                        @foreach (var entry in net.ReverseDns)
                        {
                            <div class="row">
                                <div data-label="Address" class="mono cell-text">@entry.Ip</div>
                                <div data-label="Host name">
                                    @if (net.CanEditReverseDns)
                                    {
                                        <input class="mono" value="@Draft(entry)" @oninput="e => _ptrDrafts[entry.Ip] = e.Value?.ToString() ?? string.Empty"
                                               placeholder="Provider default" spellcheck="false" aria-label="Host name for @entry.Ip" />
                                    }
                                    else
                                    {
                                        <span class="mono cell-text">@(entry.Ptr ?? "–")</span>
                                    }
                                </div>
                                <div class="row-actions">
                                    @if (IsChanged(entry))
                                    {
                                        <button class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="() => _ptrDrafts.Remove(entry.Ip)">Undo</button>
                                        <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => SavePtrAsync(entry)">Save</button>
                                    }
                                    else if (net.CanEditReverseDns && entry.IsRemovable && entry.Ptr is not null)
                                    {
                                        @if (_confirmRemovePtr == entry.Ip)
                                        {
                                            <button class="btn btn-sm" @onclick="() => _confirmRemovePtr = null">Cancel</button>
                                            <button class="btn btn-sm btn-danger-solid" disabled="@_busy" @onclick="() => RemovePtrAsync(entry)">Remove</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="() => _confirmRemovePtr = entry.Ip" title="Remove"><Icon Name="trash" /><span class="sr-only">Remove reverse DNS of @entry.Ip</span></button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                        @if (net.CanEditReverseDns && HasIpv6Network(net))
                        {
                            <div class="row add">
                                <div data-label="IPv6 address"><input class="mono" @bind="_newPtrIp" @bind:event="oninput" spellcheck="false" aria-label="IPv6 address to add" /></div>
                                <div data-label="Host name"><input class="mono" @bind="_newPtrValue" @bind:event="oninput" placeholder="mail.example.com" spellcheck="false" aria-label="Host name for the new address" /></div>
                                <div class="row-actions"><button class="btn btn-sm" disabled="@_busy" @onclick="AddPtrAsync"><Icon Name="plus" />Add IPv6 address</button></div>
                            </div>
                        }
                    </div>
                    @if (_addPtrHint is not null)
                    {
                        <p class="field-error" role="alert">@_addPtrHint</p>
                    }
                    @if (net.CanEditReverseDns && HasIpv6Network(net))
                    {
                        <p class="hint">The last row names another address in @net.PublicIpv6. Clear a host name and save to reset it to the provider default.</p>
                    }
                }
            </section>

            <section class="panel-section" aria-labelledby="private-networks">
                <h3 id="private-networks">Private networks</h3>
                @if (net.PrivateNetworks.Count == 0)
                {
                    <p class="hint">Not attached to a private network.</p>
                }
                else
                {
                    <div class="edit-grid two">
                        <div class="row head"><span>Network</span><span>Private address</span><span></span></div>
                        @foreach (var attachment in net.PrivateNetworks)
                        {
                            <div class="row">
                                <div data-label="Network" class="cell-text">@attachment.NetworkName</div>
                                <div data-label="Private address" class="mono cell-text">@attachment.Ip</div>
                                <div class="row-actions">
                                    @if (net.CanManagePrivateNetworks)
                                    {
                                        @if (_confirmDetach == attachment.NetworkId)
                                        {
                                            <button class="btn btn-sm" @onclick="() => _confirmDetach = null">Cancel</button>
                                            <button class="btn btn-sm btn-danger-solid" disabled="@_busy" @onclick="() => DetachAsync(attachment.NetworkId)">Detach</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-ghost" disabled="@_busy" @onclick="() => _confirmDetach = attachment.NetworkId">Detach…</button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (net.CanManagePrivateNetworks)
                {
                    var joinable = _view.AvailableNetworks.Where(n => net.PrivateNetworks.All(a => a.NetworkId != n.ExternalId)).ToList();
                    @if (joinable.Count > 0)
                    {
                        <div class="inline-form">
                            <label class="field"><span>Join a network</span>
                                <select @bind="_joinNetworkId">
                                    <option value="">Choose a network</option>
                                    @foreach (var network in joinable)
                                    {
                                        <option value="@network.ExternalId">@network.Name (@network.IpRange)</option>
                                    }
                                </select>
                            </label>
                            <button class="btn" disabled="@_busy" @onclick="JoinAsync">Join</button>
                        </div>
                    }
                    <div class="inline-form">
                        <label class="field"><span>New network</span><input @bind="_newNetworkName" @bind:event="oninput" placeholder="backend" maxlength="@ServerNetworks.MaxNetworkNameLength" /></label>
                        <label class="field"><span>IP range</span><input class="mono" @bind="_newNetworkRange" @bind:event="oninput" spellcheck="false" /></label>
                        <button class="btn" disabled="@_busy" @onclick="CreateNetworkAsync"><Icon Name="plus" />Create and join</button>
                    </div>
                    @if (_networkHint is not null)
                    {
                        <p class="field-error" role="alert">@_networkHint</p>
                    }
                    <p class="hint">Servers in the same private network reach each other without going over the internet. A subnet for the server's network zone is added when needed.</p>
                }
                else
                {
                    <p class="hint">Private networks of this provider are managed in its own console for now.</p>
                }
            </section>
        </div>
    }
</section>

@code {
    private ServerNetworkView? _view;
    private string? _error;
    private bool _loading;
    private bool _busy;
    private readonly Dictionary<string, string> _ptrDrafts = [];
    private string _newPtrIp = "";
    private string? _addPtrHint;
    private string? _networkHint;
    private string? _confirmRemovePtr;
    private string _newPtrValue = "";
    private string? _confirmDetach;
    private string _joinNetworkId = "";
    private string _newNetworkName = "";
    private string _newNetworkRange = "10.0.0.0/16";

    [Parameter, EditorRequired] public Guid ServerId { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _view = await Runner.RunAsync<ServerNetworks, ServerNetworkView>(u => u.GetAsync(ServerId, CancellationToken.None));
            // The first address of the server's IPv6 network is the usual one to name.
            if (_newPtrIp.Length == 0 && _view.Networking?.PublicIpv6 is { } prefix)
                _newPtrIp = Ipv6Example(prefix);
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
            _view ??= new ServerNetworkView(null, [], "Networking could not be loaded.");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Ipv6Example(string prefix) => prefix.Split('/')[0] + "1";

    private string Draft(ReverseDnsEntry entry) => _ptrDrafts.GetValueOrDefault(entry.Ip) ?? entry.Ptr ?? "";

    private bool IsChanged(ReverseDnsEntry entry) =>
        _ptrDrafts.TryGetValue(entry.Ip, out var draft) && draft.Trim() != (entry.Ptr ?? "");

    /// <summary>A whole IPv6 network (Hetzner's /64) lets every address in it get a name; a single address does not.</summary>
    private static bool HasIpv6Network(ServerNetworking net) => net.PublicIpv6?.Contains('/') == true;

    private Task RemovePtrAsync(ReverseDnsEntry entry) => RunAsync(async () =>
    {
        await Runner.RunAsync<ServerNetworks>(u => u.SetReverseDnsAsync(ServerId, entry.Ip, null, CancellationToken.None));
        _confirmRemovePtr = null;
    });

    private Task SavePtrAsync(ReverseDnsEntry entry) => RunAsync(async () =>
    {
        await Runner.RunAsync<ServerNetworks>(u => u.SetReverseDnsAsync(ServerId, entry.Ip, _ptrDrafts[entry.Ip], CancellationToken.None));
        _ptrDrafts.Remove(entry.Ip);
    });

    private Task AddPtrAsync()
    {
        _addPtrHint = string.IsNullOrWhiteSpace(_newPtrIp) ? "Enter an IPv6 address."
            : string.IsNullOrWhiteSpace(_newPtrValue) ? "Enter the host name the address should resolve to."
            : null;
        if (_addPtrHint is not null)
            return Task.CompletedTask;

        return RunAsync(async () =>
        {
            await Runner.RunAsync<ServerNetworks>(u => u.SetReverseDnsAsync(ServerId, _newPtrIp, _newPtrValue, CancellationToken.None));
            (_newPtrIp, _newPtrValue, _addPtrHint) = ("", "", null);
        });
    }

    private Task JoinAsync()
    {
        _networkHint = string.IsNullOrEmpty(_joinNetworkId) ? "Choose the network to join." : null;
        return _networkHint is not null ? Task.CompletedTask : JoinCoreAsync();
    }

    private Task JoinCoreAsync() => RunAsync(async () =>
    {
        await Runner.RunAsync<ServerNetworks>(u => u.AttachAsync(ServerId, _joinNetworkId, CancellationToken.None));
        _joinNetworkId = "";
    });

    private Task DetachAsync(string networkId) => RunAsync(async () =>
    {
        await Runner.RunAsync<ServerNetworks>(u => u.DetachAsync(ServerId, networkId, CancellationToken.None));
        _confirmDetach = null;
    });

    private Task CreateNetworkAsync()
    {
        _networkHint = string.IsNullOrWhiteSpace(_newNetworkName) ? "Enter a name for the new network." : null;
        return _networkHint is not null ? Task.CompletedTask : CreateNetworkCoreAsync();
    }

    private Task CreateNetworkCoreAsync() => RunAsync(async () =>
    {
        await Runner.RunAsync<ServerNetworks>(u => u.CreateNetworkAsync(ServerId, _newNetworkName, _newNetworkRange, CancellationToken.None));
        _newNetworkName = "";
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
