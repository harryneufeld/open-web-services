@* The inbound firewall ows manages for one server, always shown as its editable rules (docs/design.md),
   plus read-only firewalls set up elsewhere. *@
@inject UseCaseRunner Runner

<section class="panel" aria-labelledby="firewall">
    <div class="panel-header">
        <div>
            <h2 id="firewall">Firewall</h2>
            <p>Inbound rules at the provider. Traffic no rule allows is dropped; outbound traffic is not restricted.</p>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="panel-body"><Notice Kind="error">@_error</Notice></div>
    }
    @if (_view is null)
    {
        <SkeletonRows Count="2" />
    }
    else if (_view.Firewall is not { } firewall)
    {
        <div class="panel-body"><Notice>@_view.Unavailable</Notice></div>
    }
    else
    {
        var managed = firewall.ManagedRules is not null;
        <div class="panel-body stack">
            @if (!firewall.IsFiltered)
            {
                <Notice Kind="warn">No firewall applies: every port that a program on the server listens on is reachable from the internet. The rules below take effect once you turn the firewall on.</Notice>
            }

            <section class="panel-section" aria-label="Rules managed by ows">
                <div class="edit-grid rules">
                    <div class="row head"><span>Protocol</span><span>Port</span><span>Sources</span><span>Description</span><span></span></div>
                    @foreach (var row in _rows)
                    {
                        <div class="row">
                            <div data-label="Protocol">
                                <select @bind="row.Protocol" aria-label="Protocol">
                                    @foreach (var protocol in Enum.GetValues<FirewallProtocol>())
                                    {
                                        <option value="@protocol">@protocol.ToString().ToUpperInvariant()</option>
                                    }
                                </select>
                            </div>
                            <div data-label="Port">
                                @if (row.Protocol == FirewallProtocol.Icmp)
                                {
                                    <span class="cell-text subtle">All</span>
                                }
                                else
                                {
                                    <input class="mono" @bind="row.Port" @bind:event="oninput" placeholder="443" aria-label="Port or range" />
                                }
                            </div>
                            <div data-label="Sources" class="wide"><input class="mono" @bind="row.Sources" @bind:event="oninput" placeholder="0.0.0.0/0, ::/0" spellcheck="false" aria-label="Source ranges" /></div>
                            <div data-label="Description" class="wide"><input @bind="row.Description" @bind:event="oninput" maxlength="@ServerFirewalls.MaxDescriptionLength" aria-label="Description" /></div>
                            <div class="row-actions"><button class="btn btn-sm btn-ghost" @onclick="() => _rows.Remove(row)" title="Remove rule"><Icon Name="trash" /><span class="sr-only">Remove rule</span></button></div>
                        </div>
                    }
                </div>
                <div class="actions">
                    <button class="btn btn-sm" @onclick="() => _rows.Add(new RuleRow())"><Icon Name="plus" />Add rule</button>
                    @foreach (var preset in ServerFirewalls.Presets)
                    {
                        <button class="btn btn-sm btn-ghost" @onclick="() => _rows.Add(RuleRow.From(preset.Rule))"><Icon Name="plus" />@preset.Name</button>
                    }
                </div>
                @if (!AllowsSsh)
                {
                    <p class="field-error" role="alert">No rule allows SSH (TCP 22). You lose remote shell access, and ows cannot install apps on this server.</p>
                }
                <p class="hint">Sources are IP addresses or ranges, separated by commas; 0.0.0.0/0 and ::/0 allow everyone. Ports are single ports or ranges such as 8000-8100.</p>
            </section>

            @foreach (var other in firewall.OtherFirewalls)
            {
                <section class="panel-section" aria-label="@other.Name">
                    <h3>@other.Name <span class="tag">Managed outside ows</span></h3>
                    @if (other.InboundRules.Count == 0)
                    {
                        <p class="hint">No inbound rules: this firewall blocks all inbound traffic.</p>
                    }
                    else
                    {
                        <div class="edit-grid rules">
                            <div class="row head"><span>Protocol</span><span>Port</span><span>Sources</span><span>Description</span><span></span></div>
                            @foreach (var rule in other.InboundRules)
                            {
                                <div class="row">
                                    <div data-label="Protocol"><span class="tag">@rule.Protocol.ToString().ToUpperInvariant()</span></div>
                                    <div data-label="Port" class="mono cell-text">@(rule.Port ?? "All")</div>
                                    <div data-label="Sources" class="mono cell-text wide">@string.Join(", ", rule.Sources.Select(SourceLabel))</div>
                                    <div data-label="Description" class="cell-text wide">@rule.Description</div>
                                    <div></div>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </div>
        <div class="panel-footer">
            @if (managed)
            {
                @if (_confirmRemove)
                {
                    <button class="btn" @onclick="() => _confirmRemove = false">Keep firewall</button>
                    <button class="btn btn-danger-solid" disabled="@_busy" @onclick="RemoveAsync" style="margin-right:auto">Remove firewall</button>
                }
                else
                {
                    <button class="btn btn-danger" disabled="@_busy" @onclick="() => _confirmRemove = true" style="margin-right:auto">Remove firewall…</button>
                }
                @if (IsDirty)
                {
                    <button class="btn" disabled="@_busy" @onclick="ResetRows">Undo changes</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
                        @if (_busy)
                        {
                            <span class="spinner"></span>
                        }
                        Save rules
                    </button>
                }
                else
                {
                    <span class="subtle" style="align-self:center">Rules are active at the provider.</span>
                }
            }
            else
            {
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
                    @if (_busy)
                    {
                        <span class="spinner"></span>
                    }
                    Turn on firewall
                </button>
            }
        </div>
    }
</section>

@code {
    private ServerFirewallView? _view;
    private List<RuleRow> _rows = [];
    private string _saved = "";
    private string? _error;
    private bool _busy;
    private bool _confirmRemove;

    [Parameter, EditorRequired] public Guid ServerId { get; set; }

    private bool AllowsSsh => _rows.Any(r => r.Protocol == FirewallProtocol.Tcp && CoversPort(r.Port, 22));

    /// <summary>The rules differ from what is active at the provider.</summary>
    private bool IsDirty => Snapshot(_rows) != _saved;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _view = await Runner.RunAsync<ServerFirewalls, ServerFirewallView>(u => u.GetAsync(ServerId, CancellationToken.None));
            ResetRows();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
            _view ??= new ServerFirewallView(null, "The firewall could not be loaded.");
        }
    }

    /// <summary>Shows the active rules, or the usual web server rules as a proposal when there is no ows firewall yet.</summary>
    private void ResetRows()
    {
        var active = _view?.Firewall?.ManagedRules;
        _rows = active is null
            ? [.. ServerFirewalls.Presets.Take(3).Select(p => RuleRow.From(p.Rule))]
            : [.. active.Select(RuleRow.From)];
        _saved = active is null ? "" : Snapshot(_rows);
        _confirmRemove = false;
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        var rules = _rows.Select(r => r.ToRule()).ToList();
        await Runner.RunAsync<ServerFirewalls>(u => u.SaveAsync(ServerId, rules, CancellationToken.None));
    });

    private Task RemoveAsync() => RunAsync(() =>
        Runner.RunAsync<ServerFirewalls>(u => u.RemoveAsync(ServerId, CancellationToken.None)));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (Exception ex) when (UserFacingErrors.Matches(ex))
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Snapshot(IEnumerable<RuleRow> rows) =>
        string.Join("\n", rows.Select(r => $"{r.Protocol}|{(r.Protocol == FirewallProtocol.Icmp ? "" : r.Port.Trim())}|{r.Sources.Trim()}|{r.Description.Trim()}"));

    private static string SourceLabel(string source) => source switch
    {
        IpRanges.AnyIpv4 => "any IPv4",
        IpRanges.AnyIpv6 => "any IPv6",
        _ => source,
    };

    private static bool CoversPort(string? port, int number)
    {
        var parts = (port ?? "").Split('-');
        return int.TryParse(parts[0], out var from) && int.TryParse(parts[^1], out var to) && from <= number && number <= to;
    }

    private sealed class RuleRow
    {
        public FirewallProtocol Protocol { get; set; } = FirewallProtocol.Tcp;
        public string Port { get; set; } = "";
        public string Sources { get; set; } = "0.0.0.0/0, ::/0";
        public string Description { get; set; } = "";

        public static RuleRow From(FirewallRule rule) => new()
        {
            Protocol = rule.Protocol,
            Port = rule.Port ?? "",
            Sources = string.Join(", ", rule.Sources),
            Description = rule.Description ?? "",
        };

        public FirewallRule ToRule() => new(
            Protocol,
            Protocol == FirewallProtocol.Icmp ? null : Port,
            Sources.Split([',', ' ', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            Description);
    }
}
