@inherits LayoutComponentBase

<header class="topbar">
    <a class="brand" href="/">Open Web Services</a>
    <AuthorizeView>
        <Authorized>
            <nav>
                <NavLink href="/" Match="NavLinkMatch.All">Servers</NavLink>
                <NavLink href="/servers/new">New server</NavLink>
                <NavLink href="/settings">Settings</NavLink>
            </nav>
            <form method="post" action="/auth/logout" class="logout">
                <AntiforgeryToken />
                <span class="muted">@context.User.Identity?.Name</span>
                <button class="btn" type="submit">Sign out</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>

<main>
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
